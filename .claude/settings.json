{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "agent": "orquestador",
  "enabledPlugins": {
    "context7@claude-plugins-official": true
  },
  "permissions": {
    "allow": [
      "Bash(uv run pytest*)",
      "Bash(uv run ruff check*)",
      "Bash(uv run ruff format --check*)",
      "Bash(uv run mypy*)",
      "Bash(uv run lint-imports*)",
      "Bash(uv run uvicorn*)",
      "Bash(uv sync --frozen*)",
      "Bash(uv --version)",
      "Bash(npm run *)",
      "Bash(npx vitest*)",
      "Bash(npx tsc*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git remote -v)",
      "Bash(tasklist*)",
      "Bash(netstat -ano*)",
      "PowerShell(uv run pytest*)",
      "PowerShell(uv run ruff check*)",
      "PowerShell(uv run ruff format --check*)",
      "PowerShell(uv run mypy*)",
      "PowerShell(uv run lint-imports*)",
      "PowerShell(uv run uvicorn*)",
      "PowerShell(uv sync --frozen*)",
      "PowerShell(npm run *)",
      "PowerShell(git status*)",
      "PowerShell(git diff*)",
      "PowerShell(git log*)",
      "PowerShell(git branch*)",
      "PowerShell(Get-Process*)",
      "PowerShell(Get-NetTCPConnection*)",
      "Bash(gh auth status*)",
      "PowerShell(gh auth status*)",
      "Bash(gh pr view*)",
      "PowerShell(gh pr view*)",
      "Bash(gh pr list*)",
      "PowerShell(gh pr list*)",
      "Bash(gh pr diff*)",
      "PowerShell(gh pr diff*)",
      "Bash(gh pr checks*)",
      "PowerShell(gh pr checks*)",
      "Bash(gh run list*)",
      "PowerShell(gh run list*)",
      "Bash(gh run view*)",
      "PowerShell(gh run view*)",
      "Bash(gh workflow list*)",
      "PowerShell(gh workflow list*)",
      "Bash(gh repo view*)",
      "PowerShell(gh repo view*)",
      "mcp__atlassian__get*",
      "mcp__atlassian__search*"
    ],
    "ask": [
      "Bash(git commit*)",
      "Bash(git add*)",
      "Bash(psql*)",
      "Bash(uv add*)",
      "Bash(uv remove*)",
      "Bash(uv lock*)",
      "Bash(pip install*)",
      "Bash(npm install*)",
      "PowerShell(git commit*)",
      "PowerShell(psql*)",
      "PowerShell(uv add*)",
      "PowerShell(Stop-Process*)",
      "Bash(gh pr create*)",
      "PowerShell(gh pr create*)",
      "Bash(gh pr edit*)",
      "PowerShell(gh pr edit*)",
      "Bash(gh pr comment*)",
      "PowerShell(gh pr comment*)",
      "Bash(gh run rerun*)",
      "PowerShell(gh run rerun*)",
      "Bash(gh workflow run*)",
      "PowerShell(gh workflow run*)"
    ],
    "deny": [
      "Bash(git push*)",
      "Bash(git reset --hard*)",
      "Bash(rm -rf*)",
      "PowerShell(git push*)",
      "PowerShell(git reset --hard*)",
      "PowerShell(Remove-Item -Recurse*)",
      "Bash(gh pr merge*)",
      "PowerShell(gh pr merge*)",
      "Bash(gh pr review*)",
      "PowerShell(gh pr review*)",
      "Bash(gh pr ready*)",
      "PowerShell(gh pr ready*)",
      "Bash(gh repo delete*)",
      "PowerShell(gh repo delete*)",
      "Bash(gh repo edit*)",
      "PowerShell(gh repo edit*)",
      "Bash(gh secret*)",
      "PowerShell(gh secret*)",
      "Bash(gh variable*)",
      "PowerShell(gh variable*)",
      "Bash(gh release*)",
      "PowerShell(gh release*)",
      "Bash(gh api*)",
      "PowerShell(gh api*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "mcp__atlassian__*merge*",
      "mcp__atlassian__*approve*",
      "mcp__atlassian__*delete*"
    ]
  }
}
