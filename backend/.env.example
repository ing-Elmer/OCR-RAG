# Copiar a `.env` (no versionado) y completar con valores reales del ambiente.
# Nunca commitear `.env`; en Railway estas mismas variables se cargan en el servicio.

# Entorno: development | staging | production
OCR_RAG_ENV=development

# Habilita /docs, /redoc y /openapi.json. Deshabilitar en producción.
OCR_RAG_DOCS_ENABLED=true

# DSN de PostgreSQL para la conexión lógica "MAIN" (lectura/escritura).
OCR_RAG_DB_MAIN_DSN=postgresql://usuario:password@localhost:5432/ocr_rag

# Firma de los JWT propios. Generar un valor aleatorio largo por ambiente (nunca reutilizar).
OCR_RAG_JWT_SIGNING_KEY=cambiar-por-un-valor-aleatorio-largo
OCR_RAG_JWT_ALGORITHM=HS256

# TTL del access token (minutos) y del refresh token (días). Opcionales: tienen default.
OCR_RAG_JWT_ACCESS_TTL_MINUTES=15
OCR_RAG_REFRESH_TTL_DAYS=7

# Orígenes permitidos por CORS, separados por coma.
OCR_RAG_CORS_ORIGINS=http://localhost:5173

# OpenAI: chat y embeddings.
OCR_RAG_OPENAI_API_KEY=sk-cambiar-por-una-api-key-real
OCR_RAG_OPENAI_CHAT_MODEL=gpt-4o-mini
OCR_RAG_OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Idiomas de Tesseract (paquetes tesseract-ocr-<lang> instalados en el runtime).
OCR_RAG_TESSERACT_LANGS=spa+eng
